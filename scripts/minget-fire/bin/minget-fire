#!/bin/zsh

# Minget external fire scheduler — template v1.4.2.
#
# Based on the installed ~/.local/bin/minget-fire (1.3.x). What 1.4.2 changes:
# - the request outcome and the reset observation are separated: an unchanged or
#   unobservable reset time is NOT a failure. `exit 0` covers all three "the request
#   ran" outcomes; only a process failure or timeout exits nonzero,
# - every log line uses the fixed sanitized vocabulary — target/start/end/exit/
#   duration/window/used/reset only. Child stdout/stderr is never logged, and no
#   identity (email, plan, path) ever appears,
# - every path, timeout and delay is overridable through MINGET_FIRE_* environment
#   variables, with the production values as defaults, so the script can be exercised
#   against fake CLIs (scripts/minget-fire/tests/run_tests.sh) without touching the
#   real accounts.
#
# Scheduling is unchanged and stays strict serial in `all`:
#   account A -> INTER_TARGET_DELAY -> account B -> INTER_TARGET_DELAY -> Command Code
# with a 120-second per-request timeout and the same fixed commands and models.

export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
umask 077

CODEX="${MINGET_FIRE_CODEX:-/opt/homebrew/bin/codex}"
CMD="${MINGET_FIRE_CMD:-/opt/homebrew/bin/cmd}"
WORKDIR="${MINGET_FIRE_WORKDIR:-/tmp/minget-fire}"
LOGDIR="${MINGET_FIRE_LOGDIR:-$HOME/Library/Logs/Minget}"

TIMEOUT_HELPER="${MINGET_FIRE_TIMEOUT_HELPER:-$HOME/.local/libexec/minget-fire/run-with-timeout.py}"
RATE_READER="${MINGET_FIRE_RATE_READER:-$HOME/.local/libexec/minget-fire/read-codex-reset.py}"

CODEX_HOME_A="${MINGET_FIRE_CODEX_HOME_A:-$HOME/.codex-minget-a}"
CODEX_HOME_B="${MINGET_FIRE_CODEX_HOME_B:-$HOME/.codex-minget-b}"

REQUEST_TIMEOUT="${MINGET_FIRE_REQUEST_TIMEOUT:-120}"
VERIFY_TIMEOUT="${MINGET_FIRE_VERIFY_TIMEOUT:-8}"
INTER_TARGET_DELAY="${MINGET_FIRE_INTER_TARGET_DELAY:-15}"

mkdir -p "$WORKDIR" "$LOGDIR"

log_line() {
    local LOGFILE="$1"
    shift
    print -r -- "[$(/bin/date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOGFILE"
}

is_epoch() {
    [[ -n "$1" && "$1" != *[^0-9]* ]]
}

format_reset() {
    /bin/date -r "$1" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || print -r -- "$1"
}

# Reads the 5-hour window observation for one CODEX_HOME. Prints "reset used" on
# success. The reader prints only those two fields; nothing from it is ever echoed
# verbatim into the log.
read_window() {
    local CODEXHOME="$1"
    local VALUE RESET USED

    VALUE=$(CODEX_HOME="$CODEXHOME" \
        "$RATE_READER" "$VERIFY_TIMEOUT" 2>/dev/null) || return 1

    RESET="${VALUE%% *}"
    USED="${VALUE##* }"
    is_epoch "$RESET" || return 1
    print -r -- "$RESET $USED"
}

# Runs one Codex account fire. Returns the request outcome only:
#   0   request succeeded (the reset observation is logged separately)
#   124 request timed out
#   N   request failed with the child's exit status
fire_account() {
    local ACCOUNT="$1"
    local CODEXHOME="$2"
    local LOGFILE="$LOGDIR/fire-${ACCOUNT}.log"

    local BEFORE="" BEFORE_USED="na"
    local AFTER="" AFTER_USED="na"
    local OBSERVED="" OBSERVED_USED="na"
    local RESULT=0
    local STARTED FINISHED

    if BEFORE=$(read_window "$CODEXHOME"); then
        BEFORE_USED="${BEFORE##* }"
        BEFORE="${BEFORE%% *}"
    else
        BEFORE=""
    fi

    log_line "$LOGFILE" "START target=${ACCOUNT}"
    STARTED=$(/bin/date '+%s')

    CODEX_HOME="$CODEXHOME" \
        "$TIMEOUT_HELPER" "$REQUEST_TIMEOUT" \
        "$CODEX" exec \
        --ephemeral \
        --sandbox read-only \
        --skip-git-repo-check \
        -C "$WORKDIR" \
        -m gpt-5.6-luna \
        -c 'model_reasoning_effort="none"' \
        'Reply exactly: OK'

    RESULT=$?
    FINISHED=$(/bin/date '+%s')

    if [[ "$RESULT" -ne 0 ]]; then
        log_line "$LOGFILE" "END target=${ACCOUNT} exit=${RESULT} duration=$((FINISHED - STARTED))s"
        print -r -- "" >> "$LOGFILE"
        return "$RESULT"
    fi

    log_line "$LOGFILE" "END target=${ACCOUNT} exit=0 duration=$((FINISHED - STARTED))s"

    # Read-only observation of the 5-hour window. First read 2 s after the request; only
    # a read that already shows the threshold of forward movement ends the observation.
    # A failed read, a missing baseline, or an unchanged reset time each read once more
    # after 5 s (the service may simply not have published the new window yet). No second
    # model request is ever made.
    sleep 2
    READ_STARTED=$(/bin/date '+%s')
    if AFTER=$(read_window "$CODEXHOME"); then
        AFTER_USED="${AFTER##* }"
        AFTER="${AFTER%% *}"
    else
        AFTER=""
    fi

    ADVANCED=0
    if [[ -n "$BEFORE" && -n "$AFTER" ]] && (( AFTER >= BEFORE + 60 )); then
        ADVANCED=1
    fi

    if (( ADVANCED != 1 )); then
        sleep 5
        if AFTER=$(read_window "$CODEXHOME"); then
            AFTER_USED="${AFTER##* }"
            AFTER="${AFTER%% *}"
        else
            AFTER=""
        fi
    fi
    READ_FINISHED=$(/bin/date '+%s')
    OBSERVED_USED="$AFTER_USED"
    OBSERVATION_FIELDS="window=5h duration=$((READ_FINISHED - READ_STARTED))s used_before=${BEFORE_USED} used_after=${OBSERVED_USED}"

    if [[ -n "$BEFORE" && -n "$AFTER" ]] && (( AFTER >= BEFORE + 60 )); then
        # At least the threshold of forward movement: the reset time advanced. This is
        # an observation about the reported reset time, never proof a new window opened.
        log_line "$LOGFILE" \
            "OBSERVATION_RESET_ADVANCED target=${ACCOUNT} ${OBSERVATION_FIELDS} reset_before=$(format_reset "$BEFORE") reset_after=$(format_reset "$AFTER") drift=$((AFTER - BEFORE))s"
        print -r -- "" >> "$LOGFILE"
        return 0
    fi

    if [[ -n "$BEFORE" && -n "$AFTER" ]]; then
        log_line "$LOGFILE" \
            "OBSERVATION_RESET_UNCHANGED target=${ACCOUNT} ${OBSERVATION_FIELDS} reset_before=$(format_reset "$BEFORE") reset_after=$(format_reset "$AFTER") drift=$((AFTER - BEFORE))s"
        print -r -- "" >> "$LOGFILE"
        return 0
    fi

    log_line "$LOGFILE" \
        "OBSERVATION_RESET_UNAVAILABLE target=${ACCOUNT} ${OBSERVATION_FIELDS}"
    print -r -- "" >> "$LOGFILE"
    return 0
}

fire_command_code() {
    local LOGFILE="$LOGDIR/fire-commandcode.log"
    local RESULT=0
    local STARTED FINISHED

    log_line "$LOGFILE" "START target=commandcode"
    STARTED=$(/bin/date '+%s')

    "$TIMEOUT_HELPER" "$REQUEST_TIMEOUT" \
        "$CMD" \
        --model deepseek/deepseek-v4.1-flash \
        -p 'Reply exactly: OK'

    RESULT=$?
    FINISHED=$(/bin/date '+%s')

    log_line "$LOGFILE" "END target=commandcode exit=${RESULT} duration=$((FINISHED - STARTED))s"
    print -r -- "" >> "$LOGFILE"
    return "$RESULT"
}

case "$1" in
    a)
        fire_account "A" "$CODEX_HOME_A"
        exit $?
        ;;
    b)
        fire_account "B" "$CODEX_HOME_B"
        exit $?
        ;;
    c|commandcode)
        fire_command_code
        exit $?
        ;;
    all)
        # Strict serial: A, delay, B, delay, Command Code. A failing or timing-out
        # target never cancels the rest; the aggregate exit code reports the outcomes.
        fire_account "A" "$CODEX_HOME_A"
        RESULT_A=$?

        sleep "$INTER_TARGET_DELAY"

        fire_account "B" "$CODEX_HOME_B"
        RESULT_B=$?

        sleep "$INTER_TARGET_DELAY"

        fire_command_code
        RESULT_C=$?

        if [[ "$RESULT_A" -eq 0 &&
              "$RESULT_B" -eq 0 &&
              "$RESULT_C" -eq 0 ]]; then
            print -r -- "All three requests succeeded: A=${RESULT_A} B=${RESULT_B} C=${RESULT_C}"
            exit 0
        fi

        print -r -- \
            "One or more requests failed or timed out: A=${RESULT_A} B=${RESULT_B} C=${RESULT_C}"
        exit 1
        ;;
    *)
        print -r -- "Usage: minget-fire {a|b|c|commandcode|all}"
        exit 2
        ;;
esac
